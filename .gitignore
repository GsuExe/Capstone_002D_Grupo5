# ==========================================
# 1. DEPENDENCIAS
# ==========================================
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases

# Entornos virtuales Python (Backend / IA)
venv/
.venv/
env/
ENV/
__pycache__/
*.py[cod]
*$py.class

# ==========================================
# 2. SECRETOS Y VARIABLES DE ENTORNO (CRÍTICO)
# ==========================================
# NUNCA subir archivos .env reales
.env
.env*.local
.env.development
.env.test
.env.production
.env.staging

# Claves, certificados y credenciales
*.pem
*.key
*.cert
id_rsa
id_ed25519

# EXCEPCIÓN: Permitir únicamente la plantilla de ejemplo sin secretos
!.env.example

# ==========================================
# 3. COMPILACIÓN, BUILDS Y DESPLIEGUE
# ==========================================
# Next.js
/.next/
/out/
/build
/dist

# Vercel
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Testing y cobertura
/coverage


# ==========================================
# 4. LOGS Y DEBUG
# ==========================================
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# ==========================================
# 5. ARCHIVOS DEL SISTEMA OPERATIVO Y EDITORES
# ==========================================
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Editores (VSCode, JetBrains)
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.sublime-project
*.sublime-workspace
.vs/